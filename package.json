{
  "name": "waroengku-v5",
  "version": "5.0.0",
  "description": "Waroengku V5 — automation suite (Camoufox) by Muh Rifq",
  "main": "./out/main/index.js",
  "author": "waroeng",
  "repository": { "type": "git", "url": "https://github.com/OWNER/waroengku-v5.git" },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "publish": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "camoufox-js": "^0.4.1",
    "electron-updater": "^6.8.9",
    "http-proxy-agent": "^9.1.0",
    "lucide-react": "^1.28.0",
    "playwright-core": "1.53.1",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.waroeng.waroengkuv5",
    "productName": "Waroengku V5",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      { "provider": "github" }
    ]
  }
}
